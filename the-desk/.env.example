# Copy to .env and fill in. Without a key, every agent runs offline (still works end to end).
ANTHROPIC_API_KEY=
# Model for all agents. A faster one makes live demos snappier.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force offline agents even with a key (1 = on)
MOCK=
# Offline animation speed (1 = demo pace, 3 = faster)
MOCK_SPEED=1
# Optional: folder with the hackathon data (JSON/CSV). Default: server/data/live, else the demo data
DATA_DIR=
# Optional: for scripts/pull-onesheet.js
ONESHEET_API_KEY=
PORT=8787
